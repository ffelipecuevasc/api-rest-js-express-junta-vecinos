#!/usr/bin/env node

/**
 * Dependencias de módulos (ES6+)
 */
import http from 'http';
import debugLib from 'debug';
import app from '../app.js';
import { connectDB } from '../config/database.js';

const debug = debugLib('api-rest:server');

/**
 * Obtener el puerto del entorno y almacenarlo en Express.
 */
const port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Crear el servidor HTTP.
 */
const server = http.createServer(app);

/**
 * Inicialización de la Base de Datos y Arranque del Servidor
 * Usamos Top-Level Await para garantizar la conexión antes de recibir tráfico
 */
try {
  await connectDB();
  server.listen(port);
  server.on('error', onError);
  server.on('listening', onListening);
} catch (error) {
  console.error('Fallo crítico al iniciar el servidor:', error);
  process.exit(1);
}

/**
 * Normalizar el puerto
 */
function normalizePort(val) {
  const port = parseInt(val, 10);
  if (isNaN(port)) return val; // named pipe
  if (port >= 0) return port;  // port number
  return false;
}

/**
 * Listener de eventos para el evento "error" del servidor HTTP.
 */
function onError(error) {
  if (error.syscall !== 'listen') throw error;

  const bind = typeof port === 'string' ? 'Pipe ' + port : 'Port ' + port;

  switch (error.code) {
    case 'EACCES':
      console.error(`${bind} requiere privilegios elevados`);
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(`${bind} ya está en uso`);
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Listener de eventos para el evento "listening" del servidor HTTP.
 */
function onListening() {
  const addr = server.address();
  const bind = typeof addr === 'string' ? 'pipe ' + addr : 'port ' + addr.port;
  debug(`Escuchando en ${bind}`);
  console.log(`✅ - Servidor ejecutándose en http://localhost:${port}`);
}